.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 头像卡片 */
.card {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
}

.avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #bbbbbb;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 表单 */
.form {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.form-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333333;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

/* 保存按钮 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.btn-save {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #ff5f15;
  color: #ffffff;
  font-size: 30rpx;
}

.btn-disabled {
  opacity: 0.6;
}