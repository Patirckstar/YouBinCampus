.page {
  min-height: 100vh;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.item {
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.item goods-card {
  display: block;
}

/* 操作条 */
.actions {
  display: flex;
  justify-content: flex-end;
  padding: 0 20rpx 20rpx;
}

.act {
  padding: 8rpx 28rpx;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #666666;
  background: #f5f5f5;
  border-radius: 26rpx;
}

.act-sold {
  color: #ff5f15;
  background: #fff3ec;
}

.act-del {
  color: #ff4d4f;
  background: #fff1f0;
}

.act-off {
  color: #999999;
  background: #f0f0f0;
}

.act-on {
  color: #07c160;
  background: #e8f9ef;
}