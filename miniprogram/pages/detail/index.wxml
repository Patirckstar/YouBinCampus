<view class="page" wx:if="{{goods}}">
  <!-- 图片轮播 -->
  <swiper wx:if="{{images.length}}" class="swiper" indicator-dots circular indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{images}}" wx:key="*this">
      <image class="swiper-img" src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>
  <view wx:else class="swiper swiper-empty">无图</view>

  <!-- 基本信息 -->
  <view class="info card">
    <view class="price-row">
      <view class="dprice"><text class="dsym">¥</text>{{goods.price}}</view>
      <text class="dstatus {{goods.status === 1 ? 's-on' : (goods.status === 2 ? 's-sold' : 's-off')}}">
        {{goods.status === 1 ? '在售' : (goods.status === 2 ? '已售' : '已下架')}}
      </text>
    </view>
    <view class="dtitle">{{goods.title}}</view>
    <view class="dmeta">
      <text>{{goods.viewCount}}浏览</text>
      <text>{{goods.categoryName}}</text>
      <text>{{timeText}}</text>
    </view>
  </view>

  <!-- 描述 -->
  <view class="card">
    <view class="card-title">商品描述</view>
    <view class="ddesc">{{goods.description || '卖家很懒，什么都没写～'}}</view>
  </view>

  <!-- 卖家信息 -->
  <view class="card">
    <view class="card-title">卖家信息</view>
    <view class="seller">
      <image wx:if="{{avatarUrl}}" class="seller-avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="seller-avatar seller-avatar-placeholder">友</view>
      <text class="seller-name">{{goods.sellerNickname || '校园用户'}}</text>
    </view>
  </view>

  <view class="gap"></view>

  <!-- 卖家操作条 -->
  <view wx:if="{{isOwner}}" class="owner-bar">
    <button class="owner-btn" bind:tap="onEdit">编辑</button>
    <button wx:if="{{goods.status === 1}}" class="owner-btn owner-sold" bind:tap="onSold">标记已售</button>
    <button wx:if="{{goods.status === 1}}" class="owner-btn owner-off" bind:tap="onOffline">下架</button>
    <button wx:if="{{goods.status === 0}}" class="owner-btn owner-on" bind:tap="onOnline">上架</button>
    <button class="owner-btn owner-del" bind:tap="onDelete">删除</button>
  </view>
  <view wx:if="{{isOwner}}" class="owner-bar owner-sub">
    <button class="owner-btn owner-want" bind:tap="onShowWanters">谁想要({{wantCount}})</button>
    <button class="owner-btn owner-contact" bind:tap="onShowContacts">联系记录</button>
  </view>
</view>

<view wx:if="{{loading}}" class="empty">加载中...</view>
<view wx:if="{{!loading && !goods}}" class="empty">商品不存在或已删除</view>

<!-- 底部固定操作 -->
<view wx:if="{{goods}}" class="bottom-bar">
  <view class="fav-btn {{isFav ? 'faved' : ''}}" bind:tap="onToggleFav">
    <text class="fav-icon">{{isFav ? '❤' : '🤍'}}</text>
    <text class="fav-text">{{isFav ? '已收藏' : '收藏'}}</text>
  </view>
  <view wx:if="{{!isOwner}}" class="fav-btn want-btn {{isWanted ? 'wanted' : ''}}" bind:tap="onToggleWant">
    <text class="fav-icon">{{isWanted ? '⭐' : '☆'}}</text>
    <text class="fav-text">{{isWanted ? '已想要' : '想要'}}</text>
  </view>
  <button wx:if="{{!isOwner}}" class="contact-btn" bind:tap="onContact">联系卖家</button>
</view>