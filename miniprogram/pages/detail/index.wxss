.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

/* 轮播 */
.swiper {
  width: 100%;
  height: 500rpx;
  background: #f0f0f0;
}

.swiper-img {
  width: 100%;
  height: 500rpx;
}

.swiper-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbbbbb;
  font-size: 28rpx;
}

/* 卡片 */
.card {
  margin: 20rpx 20rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.card-title {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.info {
  margin-top: 20rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dprice {
  color: #ff5f15;
  font-size: 48rpx;
  font-weight: 700;
}

.dsym {
  font-size: 28rpx;
  font-weight: 500;
}

.dstatus {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.s-on {
  color: #ff5f15;
  background: #fff3ec;
}

.s-off {
  color: #999999;
  background: #f0f0f0;
}

.s-sold {
  color: #ffffff;
  background: #bbbbbb;
}

.dtitle {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #333333;
  line-height: 44rpx;
}

.dmeta {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #999999;
}

.dmeta text {
  margin-right: 24rpx;
}

.ddesc {
  font-size: 28rpx;
  color: #555555;
  line-height: 42rpx;
  word-break: break-all;
}

/* 卖家 */
.seller {
  display: flex;
  align-items: center;
}

.seller-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.seller-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff5f15;
  font-size: 32rpx;
  font-weight: 600;
}

.seller-name {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333333;
}

.gap {
  height: 24rpx;
}

/* 卖家操作条 */
.owner-bar {
  display: flex;
  margin: 20rpx 20rpx 0;
}

.owner-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: #ffffff;
  color: #333333;
  margin-right: 16rpx;
}

.owner-btn:last-child {
  margin-right: 0;
}

.owner-sold {
  color: #ff5f15;
  background: #fff3ec;
}

.owner-del {
  color: #ff4d4f;
  background: #fff1f0;
}

.owner-sub {
  margin-top: 16rpx;
}

.owner-want {
  color: #ff5f15;
  background: #fff3ec;
}

.owner-contact {
  color: #ff5f15;
  background: #fff3ec;
}

.owner-off {
  color: #999999;
  background: #f0f0f0;
}

.owner-on {
  color: #07c160;
  background: #e8f9ef;
}

/* 底部操作条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f2f2f2;
}

.fav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
}

.fav-icon {
  font-size: 40rpx;
}

.fav-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #999999;
}

.faved .fav-text {
  color: #ff5f15;
}

.want-btn {
  margin-left: 8rpx;
}

.wanted .fav-text {
  color: #ff5f15;
}

.contact-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: #ff5f15;
  color: #ffffff;
  font-size: 30rpx;
}