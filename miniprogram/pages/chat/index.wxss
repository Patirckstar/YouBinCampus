.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 顶部商品提示条 */
.goods-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f2f2f2;
}

.goods-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  color: #888888;
}

/* 消息列表 */
.msg-list {
  padding: 24rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row.mine {
  justify-content: flex-end;
}

.msg-row.other {
  justify-content: flex-start;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  word-break: break-all;
}

.mine .bubble {
  background: #ff5f15;
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

.other .bubble {
  background: #ffffff;
  color: #333333;
  border-top-left-radius: 4rpx;
}

/* 底部输入栏 */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f2f2f2;
}

.input {
  flex: 1;
  height: 68rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 34rpx;
  font-size: 28rpx;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  width: 144rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 34rpx;
  background: #ff5f15;
  color: #ffffff;
  font-size: 28rpx;
}