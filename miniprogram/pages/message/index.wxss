.page {
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.list {
  padding: 20rpx 24rpx;
}

.conv {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff5f15;
  font-size: 36rpx;
  font-weight: 600;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  box-sizing: border-box;
}

.conv-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.conv-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nick {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  color: #333333;
}

.time {
  margin-left: 16rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #bbbbbb;
}

.conv-bottom {
  margin-top: 8rpx;
}

.goods {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  color: #999999;
}

.last {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  color: #888888;
}

.thumb {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  margin-left: 20rpx;
  background: #f0f0f0;
}

.thumb-empty {
  background: #f5f5f5;
}