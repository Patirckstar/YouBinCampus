.page {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索框 */
.search-bar {
  padding: 16rpx 24rpx;
  background: #ffffff;
}

.search-box {
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 34rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #999999;
}

/* 分类 chips */
.chips {
  background: #ffffff;
  white-space: nowrap;
  padding-bottom: 16rpx;
}

.chips-inner {
  display: inline-block;
  padding: 0 24rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 32rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666666;
  background: #f5f5f5;
  border-radius: 30rpx;
}

.chip-active {
  color: #ffffff;
  background: #ff5f15;
}

/* 商品列表 */
.list {
  padding: 20rpx 24rpx 140rpx;
}

.list goods-card {
  display: block;
  margin-bottom: 20rpx;
}

.loading-tip {
  text-align: center;
  color: #999999;
  font-size: 24rpx;
  padding: 20rpx 0;
}

/* 发布按钮 */
.publish-btn {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 36rpx;
  background: #ff5f15;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 95, 21, 0.35);
}

.publish-plus {
  font-size: 36rpx;
  margin-right: 8rpx;
  line-height: 1;
}