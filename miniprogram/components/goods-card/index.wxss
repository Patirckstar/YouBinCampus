/* 商品卡片 */
.gc {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 20rpx;
  box-sizing: border-box;
}

.gc-thumb {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
}

.gc-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  display: block;
}

.gc-placeholder {
  background: #f0f0f0;
  color: #bbbbbb;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gc-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.gc-title {
  font-size: 30rpx;
  color: #333333;
  line-height: 40rpx;
  height: 80rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.gc-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 22rpx;
  color: #999999;
}

.gc-cat {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #fff3ec;
  color: #ff5f15;
  margin-right: 12rpx;
}

.gc-time {
  margin-left: 12rpx;
}

.gc-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gc-price {
  color: #ff5f15;
  font-size: 34rpx;
  font-weight: 600;
}

.gc-price-symbol {
  font-size: 24rpx;
  font-weight: 500;
}

.gc-status {
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
}

.status-on {
  color: #ff5f15;
  background: #fff3ec;
}

.status-off {
  color: #999999;
  background: #f0f0f0;
}

.status-sold {
  color: #ffffff;
  background: #bbbbbb;
}