<view class="gc" bind:tap="onTap">
  <view class="gc-thumb">
    <image wx:if="{{image}}" class="gc-img" src="{{image}}" mode="aspectFill" lazy-load="{{true}}" />
    <view wx:else class="gc-img gc-placeholder">无图</view>
  </view>
  <view class="gc-body">
    <view class="gc-title">{{goods.title}}</view>
    <view class="gc-meta">
      <text class="gc-cat">{{goods.categoryName}}</text>
      <text class="gc-view">{{goods.viewCount}}浏览</text>
      <text wx:if="{{timeText}}" class="gc-time">{{timeText}}</text>
    </view>
    <view class="gc-bottom">
      <view class="gc-price"><text class="gc-price-symbol">¥</text>{{goods.price}}</view>
      <text wx:if="{{showStatus && statusText}}" class="gc-status {{statusClass}}">{{statusText}}</text>
    </view>
  </view>
</view>